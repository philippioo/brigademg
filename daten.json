{"stand":"2026-11-08","news":[{"id":"sommerfest-35-jahre","title":"Sommerfest & 35 Jahre Brigade","cat":"Jubiläum","date":"2027-07-10","place":"","createdAt":1794156100000,"body":"35 Jahre Brigade – das muss gefeiert werden! 1992 haben fünf Jungs in Eicken angefangen, heute steht die Bulldogge stärker da denn je. Zu unserem Jubiläum laden wir zum großen Sommerfest ein: gutes Essen, kalte Getränke, alte Geschichten von unzähligen Auswärtsfahrten und jede Menge Borussia im Herzen.\n\nKorrekte Kameraden sind herzlich willkommen – Termin schon mal fett im Kalender markieren!\n\nWeitere Infos folgen."}],"photos":[{"id":"hamburg-2026-01","asset":"f45e772f6fe3c768cb5c1ae15482e33e","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000000,"src":"fotos/f45e772f6fe3c768cb5c1ae15482e33e.jpg","date":"2026-11-06"},{"id":"hamburg-2026-02","asset":"b626c5ce1f3144fe1927fbd95eed2885","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000001,"src":"fotos/b626c5ce1f3144fe1927fbd95eed2885.jpg","date":"2026-11-06"},{"id":"hamburg-2026-03","asset":"e88dc0d95bc53a65955b49e795938347","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000002,"src":"fotos/e88dc0d95bc53a65955b49e795938347.jpg","date":"2026-11-06"},{"id":"hamburg-2026-04","asset":"7fa01f52fdc13fa65d2413e8774db934","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000003,"src":"fotos/7fa01f52fdc13fa65d2413e8774db934.jpg","date":"2026-11-06"},{"id":"hamburg-2026-05","asset":"27f4345e62341ef34f8c69ab3f417e0c","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000004,"src":"fotos/27f4345e62341ef34f8c69ab3f417e0c.jpg","date":"2026-11-06"},{"id":"hamburg-2026-06","asset":"d910d0739e720e83fbf357e4ff4565b5","caption":"","year":"2026","album":"Hamburg 2026","createdAt":1794170000005,"src":"fotos/d910d0739e720e83fbf357e4ff4565b5.jpg","date":"2026-11-06"},{"id":"hamburg-2026-07","asset":"f54a12363f0b5d516917e662d34891b0","caption":"","year":"2026",