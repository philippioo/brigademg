 "news": [
  {
   "id": "sommerfest-35-jahre",
   "title": "Sommerfest & 35 Jahre Brigade",
   "cat": "Jubiläum",
   "date": "2027-07-10",
   "place": "",
   "createdAt": 1794156100000,
   "body": "35 Jahre Brigade – das muss gefeiert werden! 1992 haben fünf Jungs in Eicken angefangen, heute steht die Bulldogge stärker da denn je. Zu unserem Jubiläum laden wir zum großen Sommerfest ein: gutes Essen, kalte Getränke, alte Geschichten von unzähligen Auswärtsfahrten und jede Menge Borussia im Herzen.\n\nKorrekte Kameraden sind herzlich willkommen – Termin schon mal fett im Kalender markieren!\n\nWeitere Infos folgen."
  }
 ],
